<?xml version="1.0" encoding="utf-8"?>
<!-- Cryonix spinner background with integrated down arrow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#0E1C38" />
            <stroke android:width="1dp" android:color="#243D6B" />
        </shape>
    </item>
    <item
        android:width="14dp"
        android:height="14dp"
        android:gravity="end|center_vertical"
        android:right="14dp"
        android:drawable="@drawable/cryonix_spinner_arrow" />
</layer-list>

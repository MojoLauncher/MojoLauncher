
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#100B18"
    android:padding="20dp">

    <TextView
        android:id="@+id/control_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KARABAKH CONTROL CENTER"
        android:textColor="#B77AFF"
        android:textSize="23sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/control_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Customize your Minecraft controls"
        android:textColor="#C5B6D8"
        android:textSize="13sp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/control_title"
        app:layout_constraintStart_toStartOf="parent"/>

    <LinearLayout
        android:id="@+id/control_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="#21152F"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/control_subtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONTROL SETTINGS"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="17sp"/>

        <Button
            android:id="@+id/knw_edit_controls"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="15dp"
            android:text="EDIT CONTROL LAYOUT"
            android:textColor="#FFFFFF"
            android:backgroundTint="#8B3DFF"/>

        <Button
            android:id="@+id/knw_control_size"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:text="BUTTON SIZE"
            android:textColor="#FFFFFF"
            android:backgroundTint="#38204F"/>

        <Button
            android:id="@+id/knw_control_opacity"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:text="BUTTON OPACITY"
            android:textColor="#FFFFFF"
            android:backgroundTint="#38204F"/>

        <Button
            android:id="@+id/knw_control_profiles"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:text="CONTROL PROFILES"
            android:textColor="#FFFFFF"
            android:backgroundTint="#38204F"/>

        <Button
            android:id="@+id/knw_control_reset"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:text="RESET CONTROLS"
            android:textColor="#FFFFFF"
            android:backgroundTint="#54204F"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

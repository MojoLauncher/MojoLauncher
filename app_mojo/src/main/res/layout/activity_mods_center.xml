
<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#100B18"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KARABAKH NETWORK"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="MODS CENTER"
            android:textColor="#B77AFF"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/mod_search"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="22dp"
            android:background="#21152F"
            android:hint="Mod axtar..."
            android:padding="15dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#C5B6D8"
            android:singleLine="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="MOD SOURCE"
            android:textColor="#B77AFF"
            android:textStyle="bold"/>

        <Spinner
            android:id="@+id/mod_source"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="#21152F"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="MINECRAFT VERSION"
            android:textColor="#B77AFF"
            android:textStyle="bold"/>

        <Spinner
            android:id="@+id/mod_version"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="#21152F"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="MOD LOADER"
            android:textColor="#B77AFF"
            android:textStyle="bold"/>

        <Spinner
            android:id="@+id/mod_loader"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="#21152F"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="CATEGORY"
            android:textColor="#B77AFF"
            android:textStyle="bold"/>

        <Spinner
            android:id="@+id/mod_category"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="#21152F"/>

        <Button
            android:id="@+id/mod_search_button"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#8B3DFF"
            android:text="SEARCH MODS"
            android:textColor="#FFFFFF"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="SEARCH RESULTS"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <ProgressBar
            android:id="@+id/mod_loading"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/mod_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:text="Mod axtarmaq üçün məlumat daxil et"
            android:textColor="#C5B6D8"
            android:padding="15dp"/>

        <LinearLayout
            android:id="@+id/mod_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <Button
            android:id="@+id/mod_back"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="25dp"
            android:backgroundTint="#38204F"
            android:text="BACK"
            android:textColor="#FFFFFF"/>

    </LinearLayout>
</ScrollView>

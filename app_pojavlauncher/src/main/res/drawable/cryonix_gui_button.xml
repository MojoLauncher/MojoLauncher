<?xml version="1.0" encoding="utf-8"?>
<!-- Cryonix floating GUI button (Java install overlay / in-game controls) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#333D93FF" />
            <stroke android:width="1dp" android:color="@color/accent_blue" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#CC0E1C38" />
            <stroke android:width="1dp" android:color="#243D6B" />
        </shape>
    </item>
</selector>

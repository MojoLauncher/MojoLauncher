<?xml version="1.0" encoding="utf-8"?>
<!-- Cryonix Fabric installer: header card + section cards -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cryonix_screen_bg"
    android:orientation="vertical"
    android:clipToPadding="false">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadeScrollbars="true"
        android:scrollbarThumbVertical="@color/minebutton_color"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/_14sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/cryonix_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/_14sdp">

                <ImageView
                    android:layout_width="@dimen/_44sdp"
                    android:layout_height="@dimen/_44sdp"
                    android:background="@drawable/launcher_icon_tile"
                    android:padding="@dimen/_9sdp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_fabric" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_14sdp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/title_textview"
                        style="@style/CryonixScreenTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fabric_dl_loader_title" />

                    <TextView
                        style="@style/CryonixFieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:text="@string/fabric_dl_game_version" />
                </LinearLayout>
            </LinearLayout>

            <!-- Game version card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/cryonix_card"
                android:orientation="vertical"
                android:padding="@dimen/_14sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/fabric_installer_game_ver_spinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/_16sdp"
                        android:background="@drawable/cryonix_spinner_bg"
                        android:dropDownWidth="match_parent"
                        android:popupBackground="#0A1526"
                        android:textColor="@color/primary_text"
                        android:minHeight="48dp"
                        android:paddingVertical="0dp"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_8sdp"
                        android:rotation="180"
                        android:src="@drawable/spinner_arrow" />
                </LinearLayout>
            </LinearLayout>

            <!-- Loader version card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/cryonix_card"
                android:orientation="vertical"
                android:padding="@dimen/_14sdp">

                <TextView
                    android:id="@+id/fabric_installer_label_loader_ver"
                    style="@style/CryonixFieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fabric_dl_loader_version" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/fabric_installer_loader_ver_spinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/_16sdp"
                        android:background="@drawable/cryonix_spinner_bg"
                        android:dropDownWidth="match_parent"
                        android:popupBackground="#0A1526"
                        android:textColor="@color/primary_text"
                        android:minHeight="48dp"
                        android:paddingVertical="0dp"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_8sdp"
                        android:rotation="180"
                        android:src="@drawable/spinner_arrow" />
                </LinearLayout>
            </LinearLayout>

            <!-- Options card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/cryonix_card"
                android:orientation="vertical"
                android:padding="@dimen/_14sdp">

                <TextView
                    android:id="@+id/fabric_installer_label_options"
                    style="@style/CryonixFieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mcl_options" />

                <CheckBox
                    android:id="@+id/fabric_installer_only_stable_checkbox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:text="@string/fabric_dl_only_stable"
                    android:textColor="@color/primary_text"
                    android:textSize="@dimen/_14ssp"
                    android:minHeight="@dimen/_30sdp"
                    android:checked="true" />
            </LinearLayout>

            <!-- Retry strip -->
            <LinearLayout
                android:id="@+id/fabric_installer_retry_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/cryonix_card"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/padding_moderate"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/modloader_dl_failed_to_load_list"
                    android:textColor="@color/cryonix_error"
                    android:textSize="@dimen/_12ssp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/fabric_installer_retry_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/cryonix_button_secondary"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_blue"
                    android:text="@string/global_retry" />
            </LinearLayout>

            <!-- Progress + install -->
            <ProgressBar
                android:id="@+id/fabric_installer_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:indeterminate="true"
                android:visibility="visible" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/fabric_installer_start_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_14sdp"
                android:enabled="false"
                android:text="@string/fabric_dl_install" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

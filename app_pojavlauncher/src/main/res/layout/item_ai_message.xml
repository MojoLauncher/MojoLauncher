<?xml version="1.0" encoding="utf-8"?>
<!-- Cryonix chat message row: bot bubble (left) or user bubble (right) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/message_bot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="@dimen/_56sdp"
        android:layout_marginVertical="@dimen/_4sdp"
        android:background="@drawable/cryonix_chat_bot_bubble"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="2dp"
        android:paddingStart="@dimen/_14sdp"
        android:paddingTop="@dimen/_10sdp"
        android:paddingEnd="@dimen/_14sdp"
        android:paddingBottom="@dimen/_10sdp"
        android:textColor="@color/primary_text"
        android:textSize="@dimen/_14ssp"
        tools:text="Hello! I can guide you through setting up Cryonix Launcher V3." />

    <TextView
        android:id="@+id/message_user"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="@dimen/_56sdp"
        android:layout_marginVertical="@dimen/_4sdp"
        android:background="@drawable/cryonix_chat_user_bubble"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="2dp"
        android:paddingStart="@dimen/_14sdp"
        android:paddingTop="@dimen/_10sdp"
        android:paddingEnd="@dimen/_14sdp"
        android:paddingBottom="@dimen/_10sdp"
        android:textColor="@android:color/white"
        android:textSize="@dimen/_14ssp"
        tools:text="How do I install Java?" />
</FrameLayout>

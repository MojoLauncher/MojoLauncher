<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="240"
    android:fillAfter="true"
    android:shareInterpolator="false">
    <scale
        android:fromXScale="1.0"
        android:fromYScale="1.0"
        android:toXScale="0.985"
        android:toYScale="1.015"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="70" />
    <scale
        android:fromXScale="0.985"
        android:fromYScale="1.015"
        android:toXScale="1.012"
        android:toYScale="0.988"
        android:pivotX="50%"
        android:pivotY="50%"
        android:startOffset="70"
        android:duration="80" />
    <scale
        android:fromXScale="1.012"
        android:fromYScale="0.988"
        android:toXScale="1.0"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:startOffset="150"
        android:duration="90" />
</set>

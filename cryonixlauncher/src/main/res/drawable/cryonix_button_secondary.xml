<?xml version="1.0" encoding="utf-8"?>
<!-- Cryonix secondary button (regular <Button>): navy with blue outline, blue text -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#16305A" />
            <stroke android:width="1dp" android:color="@color/accent_blue" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#0B1526" />
            <stroke android:width="1dp" android:color="#1B2B47" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#0E1C38" />
            <stroke android:width="1dp" android:color="#2C5AA0" />
        </shape>
    </item>
</selector>

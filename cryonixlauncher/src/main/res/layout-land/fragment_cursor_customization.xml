<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050B17"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/cursor_sidebar"
        android:layout_width="58dp"
        android:layout_height="0dp"
        android:background="@drawable/cryonix_sidebar_pill"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="9dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/cursor_sidebar_home"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Home"
            android:padding="9dp"
            android:src="@drawable/ic_clean_home"
            app:tint="#6B88B4"/>

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/cursor_sidebar_pointer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/launcher_sidebar_home_bg"
            android:contentDescription="Cursor customization"
            android:padding="9dp"
            android:src="@drawable/ic_sidebar_pointer"
            app:tint="@android:color/white"/>

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/cursor_sidebar_controls"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Controls"
            android:padding="9dp"
            android:src="@drawable/ic_clean_gamepad"
            app:tint="#6B88B4"/>

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/cursor_sidebar_info"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Info"
            android:padding="9dp"
            android:src="@drawable/ic_sidebar_info"
            app:tint="#6B88B4"/>

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/cursor_sidebar_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:padding="9dp"
            android:src="@drawable/ic_sidebar_sliders"
            app:tint="#6B88B4"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cursor_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="14dp"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/cursor_sidebar"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/cursor_back"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/launcher_counter_bg"
                android:contentDescription="Back"
                android:padding="10dp"
                android:src="@drawable/ic_launcher_chevron_left"
                app:tint="#6FAEFF"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Cursor customization"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customize your cursor and see every change live in-game."
                    android:textColor="#6E86AA"
                    android:textSize="11sp"/>
            </LinearLayout>

            <Switch
                android:id="@+id/cursor_motion_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Motion Jelly"
                android:textColor="#BBD0F4"
                android:checked="true"/>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="145dp"
                    android:background="@drawable/cursor_screen_bg"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Live cursor preview"
                        android:textColor="#BBD0F4"
                        android:textSize="12sp"/>

                    <net.kdt.pojavlaunch.game.CursorPreviewView
                        android:id="@+id/cursor_preview"
                        android:layout_width="match_parent"
                        android:layout_height="105dp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="CURSOR TEMPLATES"
                    android:textColor="#4E83C6"
                    android:textSize="11sp"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="86dp"
                    android:layout_marginTop="6dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/cursor_templates"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"/>
                </HorizontalScrollView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="CURSOR COLORS"
                    android:textColor="#4E83C6"
                    android:textSize="11sp"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="6dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/cursor_colors"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"/>
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/cursor_section_bg"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cursor size"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/cursor_size_value"
                        android:layout_width="58dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="100%"
                        android:textColor="#6FAEFF"
                        android:textSize="13sp"/>

                    <SeekBar
                        android:id="@+id/cursor_size"
                        android:layout_width="180dp"
                        android:layout_height="wrap_content"
                        android:max="150"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/cursor_section_bg"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Custom cursor PNG"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/custom_cursor_name"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Not selected"
                        android:textColor="#6E86AA"
                        android:textSize="11sp"/>

                    <Button
                        android:id="@+id/custom_cursor_button"
                        android:layout_width="92dp"
                        android:layout_height="40dp"
                        android:background="@drawable/launcher_action_button"
                        android:text="Choose PNG"
                        android:textColor="#BBD0F4"
                        android:textSize="11sp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/cursor_reset"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/launcher_action_button"
                    android:text="Reset cursor"
                    android:textColor="#BBD0F4"
                    android:textSize="12sp"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
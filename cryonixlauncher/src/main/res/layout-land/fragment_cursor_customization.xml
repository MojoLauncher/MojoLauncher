<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030A16"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/cursor_sidebar"
        android:layout_width="58dp"
        android:layout_height="0dp"
        android:background="@drawable/cryonix_sidebar_pill"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="9dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/cursor_sidebar_home"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Home"
            android:padding="9dp"
            android:src="@drawable/ic_clean_home"
            app:tint="#78AFFF"/>

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/cursor_sidebar_pointer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/launcher_sidebar_home_bg"
            android:contentDescription="Cursor customization"
            android:padding="9dp"
            android:src="@drawable/ic_sidebar_pointer"
            app:tint="@android:color/white"/>

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/cursor_sidebar_controls"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Controls"
            android:padding="9dp"
            android:src="@drawable/ic_clean_gamepad"
            app:tint="#78AFFF"/>

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/cursor_sidebar_info"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Info"
            android:padding="9dp"
            android:src="@drawable/ic_sidebar_info"
            app:tint="#78AFFF"/>

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/cursor_sidebar_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:padding="9dp"
            android:src="@drawable/ic_sidebar_sliders"
            app:tint="#78AFFF"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cursor_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="14dp"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/cursor_sidebar"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/cursor_back"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/launcher_counter_bg"
                android:contentDescription="Back"
                android:padding="10dp"
                android:src="@drawable/ic_launcher_chevron_left"
                app:tint="#78AFFF"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Cursor Customization"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Make your cursor unique. Every setting updates the live preview and in-game cursor."
                    android:textColor="#6E86AA"
                    android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/cursor_section_bg"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Motion Jelly"
                    android:textColor="#BBD0F4"
                    android:textSize="11sp"/>

                <Switch
                    android:id="@+id/cursor_motion_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:checked="true"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:layout_weight="0.98"
                android:background="@drawable/cursor_screen_bg"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="◉  Live Preview"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/cursor_preview_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● Live Preview"
                        android:textColor="#45E59A"
                        android:textSize="10sp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Move your finger across the panel to test size, color, motion and effects."
                    android:textColor="#7189AE"
                    android:textSize="10sp"/>

                <net.kdt.pojavlaunch.game.CursorPreviewView
                    android:id="@+id/cursor_preview"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/cursor_preview_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/cursor_section_bg"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="7dp"
                        android:text="Cursor size: Medium"
                        android:textColor="#BBD0F4"
                        android:textSize="10sp"/>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Changes apply instantly"
                        android:textColor="#536D94"
                        android:textSize="9sp"/>
                </LinearLayout>
            </LinearLayout>

            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.12"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingEnd="2dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/cursor_section_bg"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="◈  Cursor Templates"
                            android:textColor="@android:color/white"
                            android:textSize="13sp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Choose a style or upload your own cursor."
                            android:textColor="#6E86AA"
                            android:textSize="9sp"/>

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="82dp"
                            android:layout_marginTop="7dp"
                            android:overScrollMode="never"
                            android:scrollbars="none">
                            <LinearLayout
                                android:id="@+id/cursor_templates"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:orientation="horizontal"/>
                        </HorizontalScrollView>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/cursor_section_bg"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="●  Cursor Colors"
                            android:textColor="@android:color/white"
                            android:textSize="13sp"/>

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="4dp"
                            android:overScrollMode="never"
                            android:scrollbars="none">
                            <LinearLayout
                                android:id="@+id/cursor_colors"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"/>
                        </HorizontalScrollView>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/cursor_section_bg"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="↗  Cursor Size"
                            android:textColor="@android:color/white"
                            android:textSize="13sp"/>

                        <TextView
                            android:id="@+id/cursor_size_value"
                            android:layout_width="54dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="100%"
                            android:textColor="#78AFFF"
                            android:textSize="11sp"/>

                        <SeekBar
                            android:id="@+id/cursor_size"
                            android:layout_width="155dp"
                            android:layout_height="wrap_content"
                            android:max="150"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="66dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/cursor_section_bg"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="10dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="◎  Outline"
                                android:textColor="@android:color/white"
                                android:textSize="12sp"/>

                            <Switch
                                android:id="@+id/cursor_outline_switch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/cursor_section_bg"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="10dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="≋  Trail Effect"
                                android:textColor="@android:color/white"
                                android:textSize="12sp"/>

                            <Switch
                                android:id="@+id/cursor_trail_switch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/cursor_section_bg"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="◐  Cursor Opacity"
                            android:textColor="@android:color/white"
                            android:textSize="13sp"/>

                        <TextView
                            android:id="@+id/cursor_opacity_value"
                            android:layout_width="46dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="100%"
                            android:textColor="#78AFFF"
                            android:textSize="11sp"/>

                        <SeekBar
                            android:id="@+id/cursor_opacity"
                            android:layout_width="155dp"
                            android:layout_height="wrap_content"
                            android:max="100"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/cursor_section_bg"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="↻  Cursor Rotation"
                            android:textColor="@android:color/white"
                            android:textSize="13sp"/>

                        <TextView
                            android:id="@+id/cursor_rotation_value"
                            android:layout_width="46dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="0°"
                            android:textColor="#78AFFF"
                            android:textSize="11sp"/>

                        <SeekBar
                            android:id="@+id/cursor_rotation"
                            android:layout_width="155dp"
                            android:layout_height="wrap_content"
                            android:max="360"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/cursor_section_bg"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="✦  Cursor Shadow"
                            android:textColor="@android:color/white"
                            android:textSize="13sp"/>

                        <Switch
                            android:id="@+id/cursor_shadow_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/cursor_section_bg"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="▣  Custom Cursor PNG"
                            android:textColor="@android:color/white"
                            android:textSize="13sp"/>

                        <TextView
                            android:id="@+id/custom_cursor_name"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:singleLine="true"
                            android:text="Not selected"
                            android:textColor="#6E86AA"
                            android:textSize="9sp"/>

                        <Button
                            android:id="@+id/custom_cursor_button"
                            android:layout_width="88dp"
                            android:layout_height="38dp"
                            android:background="@drawable/launcher_action_button"
                            android:text="Choose PNG"
                            android:textColor="#BBD0F4"
                            android:textSize="10sp"/>
                    </LinearLayout>

                    <Button
                        android:id="@+id/cursor_reset"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/launcher_action_button"
                        android:text="Reset cursor settings"
                        android:textColor="#BBD0F4"
                        android:textSize="11sp"/>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

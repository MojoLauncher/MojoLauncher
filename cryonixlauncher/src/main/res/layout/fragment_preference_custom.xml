<?xml version="1.0" encoding="utf-8"?>
<!-- Cryonix settings screen: header card + card preference rows -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cryonix_screen_bg"
    android:clipToPadding="false"
    android:orientation="vertical">

    <!-- Header card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_14sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginEnd="@dimen/_14sdp"
        android:background="@drawable/cryonix_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/_12sdp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="@dimen/_8sdp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_px_arrow_left"
            app:tint="@color/accent_blue" />

        <ImageView
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:background="@drawable/launcher_icon_tile"
            android:contentDescription="Settings"
            android:padding="@dimen/_9sdp"
            android:src="@drawable/ic_px_sliders"
            app:tint="@color/accent_blue" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/settings_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Settings"
                android:textColor="@color/primary_text"
                android:textSize="@dimen/_16ssp" />

            <TextView
                android:id="@+id/settings_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:text="Configure your launcher experience"
                android:textColor="@color/secondary_text"
                android:textSize="@dimen/_11ssp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Preference list -->
    <FrameLayout
        android:id="@+id/list_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/_14sdp"
        android:layout_marginVertical="@dimen/_10sdp"
        android:background="@android:color/transparent"
        android:clipToPadding="false" />
</LinearLayout>

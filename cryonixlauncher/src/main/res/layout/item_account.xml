<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="48dp"
    android:layout_width="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/launcher_account_accent_bg"
    android:layout_marginBottom="4dp">

    <fr.spse.extended_view.ExtendedTextView
        android:id="@+id/account_item"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"

        android:textSize="15sp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:drawablePadding="12dp"
        android:paddingStart="16dp"
        app:drawableStartSize="32dp"
        app:drawableEndSize="24dp"

        tools:text="User"
        tools:drawableStart="@drawable/cryonixlauncher"
        tools:ignore="RtlSymmetry" />

    <!-- Fun fact, if I put an Image button, the spinner fails to put an onclick listener on the extended view -->
    <ImageView
        android:id="@+id/delete_account_button"
        android:layout_width="@dimen/_52sdp"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackground"
        android:src="@drawable/ic_px_trash"

        android:padding="@dimen/padding_moderate"
        />

</LinearLayout>

